# ============================================================
# ResolveOS Environment Configuration
# ============================================================
# Copy this to .env and fill in your values.
# Never commit .env to git.

# ── AWS / Bedrock (Required for production) ─────────────────
# For local dev with ~/.aws credentials: leave these blank.
# For CI/CD or deployed environments: set these explicitly.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Bedrock model to use
# Options: us.amazon.nova-lite-v1:0 | us.amazon.nova-pro-v1:0
#          us.anthropic.claude-sonnet-4-5 | us.anthropic.claude-haiku-4-5
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# ── Local / Demo mode ───────────────────────────────────────
# Set LITELLM_API_BASE to use a local LLM (e.g. Ollama, vLLM)
# when no AWS credentials are available.
# Example (Ollama): LITELLM_API_BASE=http://localhost:11434/v1
# Example (LM Studio): LITELLM_API_BASE=http://localhost:1234/v1
LITELLM_API_BASE=
LITELLM_MODEL=openai/mistral

# ── Backend Server ──────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ────────────────────────────────────────────────
# Local SQLite (default). For production, use DynamoDB.
DB_PATH=backend/data/resolveos.db

# ── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── Demo Scenario ───────────────────────────────────────────
# Triggers the Northstar Components stockout demo automatically
DEMO_SCENARIO=northstar_bearing
